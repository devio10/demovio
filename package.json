{
	"name": "demovio",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun --env-file .env.development --bun vite dev",
		"build": "bun --env-file .env.production --bun vite build",
		"preview": "bun --env-file .env.production --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"db": "bun --env-file .env.development drizzle-kit studio",
		"db:generate": "bun --env-file .env.development drizzle-kit generate",
		"db:migrate": "bun --env-file .env.development drizzle-kit migrate",
		"db:prod": "bun --env-file .env.production drizzle-kit studio"
	},
